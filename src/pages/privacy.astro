---
import { getEntry, render } from 'astro:content';
import Reading from '../layouts/Reading.astro';
import { getApps } from '../lib/content';
import { localPath } from '../lib/catalog';
const apps = await getApps();
const entry = await getEntry('policies', 'website/privacy');
if (!entry) throw new Error('Missing website privacy policy');
const { Content } = await render(entry);
---

<Reading title={entry.data.title} description={entry.data.description} policy>
  {apps.length > 0 && (
    <p>
      For app data and permission choices:{' '}
      {apps.map((app, index) => (
        <>
          {index > 0 && ', '}
          <a
            href={localPath(
              `/apps/${app.slug}/privacy/`,
              import.meta.env.BASE_URL,
            )}
          >
            {app.name} privacy
          </a>
        </>
      ))}
      .
    </p>
  )}
  <Content />
</Reading>
