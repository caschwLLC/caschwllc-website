---
import { render } from 'astro:content';
import Reading from '../../../layouts/Reading.astro';
import { getApps, policyFor } from '../../../lib/content';
import type { App } from '../../../lib/catalog';
import Availability from '../../../components/Availability.astro';
import OverrideMenuBarStates from '../../../components/OverrideMenuBarStates.astro';
export async function getStaticPaths() {
  return (await getApps()).map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}
interface Props {
  app: App;
}
const { app } = Astro.props;
const entry = await policyFor(app.slug, 'support');
const { Content } = await render(entry);
---

<Reading
  title={entry.data.title}
  description={entry.data.description}
  appSlug={app.slug}
>
  {app.presentation === 'utility' && (
    <div class="support-download">
      <p>
        Beta {app.distribution.version}. {app.compatibility}
      </p>
      <Availability app={app} />
    </div>
  )}
  {app.slug === 'override' && (
    <OverrideMenuBarStates id="support-menu-bar" context="support" />
  )}
  <Content />
</Reading>
