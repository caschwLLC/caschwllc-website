---
import ScreenProduct from '../../../components/ScreenProduct.astro';
import UtilityProduct from '../../../components/UtilityProduct.astro';
import { getApps } from '../../../lib/content';
import type { App } from '../../../lib/catalog';

export async function getStaticPaths() {
  return (await getApps()).map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}
interface Props {
  app: App;
}
const { app } = Astro.props;
---

{app.presentation === 'screens' ? (
  <ScreenProduct app={app} />
) : (
  <UtilityProduct app={app} />
)}
