---
import Site from '../../../layouts/Site.astro';
import Device from '../../../components/Device.astro';
import Availability from '../../../components/Availability.astro';
import { getApps } from '../../../lib/content';
import { localPath } from '../../../lib/catalog';
import type { App } from '../../../lib/catalog';
export async function getStaticPaths() {
  return (await getApps()).map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}
interface Props {
  app: App;
}
const { app } = Astro.props;
const href = (path: string) => localPath(path, import.meta.env.BASE_URL);
---

<Site
  title={`${app.name} · ${app.headline} · caschw LLC`}
  description={app.summary}
  appSlug={app.slug}
>
  <!-- THESIS: Emotional vocabulary is made tangible by real screens, not claims.
  OWN-WORLD: Lavender stage, graphite frames, generous neutral space, mint and sky feature fields.
  STORY: Explore, reflect, practice, notice patterns; understand optional features and privacy.
  FIRST VIEWPORT: Product artwork and promise left, two genuine proportional screens right, coming-soon text and feature link.
  FORM: Approved crisp software showroom; product proof leads every chapter. -->
  <section class="product-hero wrap">
    <div class="hero-copy">
      <div class="product-name">
        <img src={href(app.icon)} width="64" height="64" alt="" />
        <p>{app.name}</p>
      </div>
      <h1>{app.headline}</h1>
      <p>{app.summary}</p>
      <div class="hero-actions">
        <Availability app={app} />
        <a class="text-link" href="#explore">
          Take a closer look <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="compatibility">{app.compatibility}</p>
    </div>
    <div class="device-pair">
      <Device media={app.hero} priority />
      <Device media={app.secondaryHero} priority />
    </div>
  </section>
  <p class="image-note wrap">
    Genuine app captures with synthetic reflections. Device surrounds are
    original illustrations.
  </p>
  <div id="explore">
    {app.features.map((feature, index) => (
      <section
        class:list={['feature', feature.tone, index % 2 === 1 && 'reverse']}
        aria-labelledby={`feature-${index}`}
      >
        <div class="feature-inner wrap">
          <div class="feature-copy">
            <h2 id={`feature-${index}`}>{feature.title}</h2>
            {feature.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <figure>
            <Device media={feature.media} />
            <figcaption>{feature.caption}</figcaption>
          </figure>
        </div>
      </section>
    ))}
  </div>
  <section class="privacy-feature wrap">
    <h2>
      Your reflections
      <br />
      stay personal.
    </h2>
    <div>
      <p>
        On your device by default. No advertising, tracking, or third-party
        analytics. No Feelory account.
      </p>
      <dl>
        <div>
          <dt>iCloud, if you choose</dt>
          <dd>
            Sync supported app data through your Apple Account’s private iCloud
            database.
          </dd>
        </div>
        <div>
          <dt>Apple Health, write-only</dt>
          <dd>
            Optionally log the primary feeling from a finished entry. Feelory
            does not read Health data or write journal text to Health.
          </dd>
        </div>
        <div>
          <dt>AI, on your device</dt>
          <dd>
            Optional help when Apple Intelligence is available. No remote AI
            service or fallback.
          </dd>
        </div>
        <div>
          <dt>Your own copy</dt>
          <dd>
            Export a JSON backup or a PDF. App lock uses your device’s
            authentication system.
          </dd>
        </div>
      </dl>
      <a class="text-link" href={href(`/apps/${app.slug}/privacy/`)}>
        Read the full privacy policy <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="closing wrap">
    <div>
      <h2>
        A moment for
        <br />
        what you feel.
      </h2>
      <p>
        {app.compatibility} Supports VoiceOver, Dynamic Type, and Reduce Motion.
      </p>
      <p class="medical-note">
        Feelory is for emotional learning and reflection. It is not a medical
        device, does not diagnose or treat conditions, and is not a substitute
        for professional care.
      </p>
    </div>
    <div class="closing-actions">
      <Availability app={app} />
      <a class="text-link" href={href(`/apps/${app.slug}/support/`)}>
        Feelory support <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Site>
