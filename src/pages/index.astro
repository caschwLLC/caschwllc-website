---
import Site from '../layouts/Site.astro';
import Device from '../components/Device.astro';
import Availability from '../components/Availability.astro';
import AppIcon from '../components/AppIcon.astro';
import { getApps } from '../lib/content';
import { localPath } from '../lib/catalog';
const apps = await getApps();
const href = (path: string) => localPath(path, import.meta.env.BASE_URL);
---

<Site
  title="caschw LLC · Software for everyday moments"
  description={`Thoughtful software for everyday moments from caschw LLC.${apps.length ? ` Explore ${apps.map((app) => app.name).join(' and ')}.` : ''}`}
>
  <!-- THESIS: A software showroom, not a grid of empty portfolio cards.
  OWN-WORLD: Chalk studio, near-black type, lavender product stage, original graphite device surrounds.
  STORY: Understand the studio, see genuine product screens, explore the app and its privacy.
  FIRST VIEWPORT: Broad studio headline, concise introduction, then a full-width product stage with two tall captures.
  FORM: Brief-pinned showroom; no seed script used under the skill's script restriction. -->
  <section class="studio-intro wrap">
    <h1>
      Software for
      <br />
      everyday moments.
    </h1>
    <p>
      A little space for what matters.
      <br />
      Thoughtful apps from caschw LLC.
    </p>
  </section>
  {apps.map((app) => (
    <section
      class:list={[
        'showcase',
        'wrap',
        app.presentation === 'utility' && 'utility-showcase',
      ]}
      aria-labelledby={`app-${app.slug}`}
    >
      <div class="showcase-copy">
        <div class="product-name">
          <AppIcon app={app} />
          <h2 id={`app-${app.slug}`}>{app.name}</h2>
        </div>
        {app.presentation === 'screens' ? (
          <Availability app={app} />
        ) : (
          <span class="status">Beta {app.distribution.version}</span>
        )}
        <h3>{app.headline}</h3>
        <p>{app.summary}</p>
        <a class="button button-secondary" href={href(`/apps/${app.slug}/`)}>
          Explore {app.name}
          <span aria-hidden="true"> ↗</span>
        </a>
        <p class="compatibility">{app.compatibility}</p>
      </div>
      {app.presentation === 'screens' ? (
        <div class="device-pair">
          <Device media={app.hero} priority />
          <Device media={app.secondaryHero} priority />
        </div>
      ) : (
        <div class="utility-showcase-detail">
          <h3>
            From the menu bar.
            <br />
            Across your windows.
          </h3>
          <p>
            Configure window controls, choose snap layouts, and pause overrides
            when you want native macOS behaviour.
          </p>
          <Availability app={app} />
        </div>
      )}
    </section>
  ))}
  {apps.some((app) => app.presentation === 'screens') && (
    <p class="image-note wrap">
      Genuine app captures , any content shown is using sample data.
    </p>
  )}
  <section class="studio-note wrap">
    <h2>
      Thoughtful tools.
      <br />
      Everyday possibilities.
    </h2>
    <div>
      <p>
        A moment to reflect. A workspace that fits the way you work. We make
        software for the small things that shape your day.
      </p>
    </div>
  </section>
</Site>
