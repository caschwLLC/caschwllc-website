---
import Site from '../layouts/Site.astro';
import Device from '../components/Device.astro';
import Availability from '../components/Availability.astro';
import { getApps } from '../lib/content';
import { localPath } from '../lib/catalog';
const apps = await getApps();
const feelory = apps.find((app) => app.slug === 'feelory');
const href = (path: string) => localPath(path, import.meta.env.BASE_URL);
---

<Site
  title="caschw LLC · Software for everyday moments"
  description={
    feelory
      ? `Thoughtful software for everyday moments. Meet ${feelory.name}, an app for emotional vocabulary and personal reflection. ${feelory.status === 'coming-soon' ? 'Coming soon.' : 'Explore the app.'}`
      : 'Thoughtful software for everyday moments from caschw LLC.'
  }
>
  <!-- THESIS: A software showroom, not a grid of empty portfolio cards.
  OWN-WORLD: Chalk studio, near-black type, lavender product stage, original graphite device surrounds.
  STORY: Understand the studio, see genuine product screens, explore the app and its privacy.
  FIRST VIEWPORT: Broad studio headline, concise introduction, then a full-width product stage with two tall captures.
  FORM: Brief-pinned showroom; no seed script used under the skill's script restriction. -->
  <section class="studio-intro wrap">
    <h1>
      Software for
      <br />
      everyday moments.
    </h1>
    <p>
      A little room to learn.
      <br />A little space to reflect.
      <br />
      Meet the apps from caschw LLC.
    </p>
  </section>
  {apps.map((app) => (
    <section class="showcase wrap" aria-labelledby={`app-${app.slug}`}>
      <div class="showcase-copy">
        <div class="product-name">
          <img src={href(app.icon)} width="64" height="64" alt="" />
          <h2 id={`app-${app.slug}`}>{app.name}</h2>
        </div>
        <Availability app={app} />
        <h3>{app.headline}</h3>
        <p>{app.summary}</p>
        <a class="button" href={href(`/apps/${app.slug}/`)}>
          Explore {app.name}
          <span aria-hidden="true"> ↗</span>
        </a>
        <p class="compatibility">For iPhone and iPad</p>
      </div>
      <div class="device-pair">
        <Device media={app.hero} priority />
        <Device media={app.secondaryHero} priority />
      </div>
    </section>
  ))}
  {apps.length > 0 && (
    <p class="image-note wrap">
      Genuine app captures with synthetic reflections. Saved AI-tag styling is
      illustrative, not a live AI result.
    </p>
  )}
  {feelory && (
    <section class="studio-note wrap">
      <h2>
        Personal means
        <br />
        yours.
      </h2>
      <div>
        <p>
          Feelory keeps your reflections on your device by default. Optional
          features are choices, not requirements.
        </p>
        <a class="text-link" href={href('/apps/feelory/privacy/')}>
          Read Feelory’s privacy policy <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={href('/apps/feelory/support/')}>
          Find Feelory support <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  )}
</Site>
