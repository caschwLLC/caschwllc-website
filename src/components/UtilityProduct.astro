---
import Site from '../layouts/Site.astro';
import Availability from './Availability.astro';
import AppIcon from './AppIcon.astro';
import OverrideMenuBarStates from './OverrideMenuBarStates.astro';
import { localPath } from '../lib/catalog';
import type { App } from '../lib/catalog';
interface Props {
  app: Extract<App, { presentation: 'utility' }>;
}
const { app } = Astro.props;
const href = (path: string) => localPath(path, import.meta.env.BASE_URL);
---

<Site
  title={`${app.name} beta · Configurable Mac window management · caschw LLC`}
  description={app.summary}
  appSlug={app.slug}
>
  <!-- THESIS: Configurable window behaviour explained directly, without simulated app screens.
  OWN-WORLD: Existing paper and ink studio, sky hero, lavender, mint and sky chapters, open text columns.
  STORY: Understand the beta, choose a download, grant window access deliberately.
  FIRST VIEWPORT: Product name and promise beside a concise capability index; beta download and compatibility stay together.
  FORM: Text-led extension of the approved showroom; no unapproved artwork. -->
  <section class="product-hero utility-hero wrap">
    <div class="hero-copy">
      <div class="product-name">
        <AppIcon app={app} />
        <p>{app.name}</p>
      </div>
      <h1>{app.headline}</h1>
      <p>{app.summary}</p>
      <div class="hero-actions">
        <Availability app={app} />
        <a class="text-link" href="#explore">
          Take a closer look <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="compatibility">{app.compatibility}</p>
      <p class="beta-note">
        Beta {app.distribution.version}. This is prerelease software; you may
        encounter bugs or app-specific limitations.
      </p>
    </div>
    <div class="utility-index">
      <h2>
        Window management,
        <br />
        from your menu bar.
      </h2>
      <dl>
        <div>
          <dt>Configure</dt>
          <dd>Hide, minimize, and window-button behaviour.</dd>
        </div>
        <div>
          <dt>Arrange</dt>
          <dd>Built-in snaps and your own grid layouts.</dd>
        </div>
        <div>
          <dt>Stay in control</dt>
          <dd>Pause, exclude apps, restore, and undo supported actions.</dd>
        </div>
      </dl>
      <p>Enable the optional behaviours you want. Leave the rest to macOS.</p>
    </div>
  </section>
  <div id="explore" class="utility-features">
    {app.features.map((feature, index) => (
      <section
        class:list={['feature', ['lavender', 'mint', 'sky'][index % 3]]}
        aria-labelledby={`feature-${index}`}
      >
        <div class="utility-feature-inner wrap">
          <h2 id={`feature-${index}`}>{feature.title}</h2>
          <div>
            {feature.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>
  <div class="utility-menu-bar wrap">
    <OverrideMenuBarStates id="product-menu-bar" />
  </div>
  <section class="utility-setup wrap" aria-labelledby="install">
    <div>
      <h2 id="install">
        A place in Applications.
        <br />A home in your menu bar.
      </h2>
      <p>
        {app.status === 'available'
          ? 'Start with the beta DMG, then install it like a Mac app.'
          : 'The beta download is not available yet. These are the steps to follow when it becomes available.'}
      </p>
      <ol class="install-steps">
        <li>
          Download <strong>Override-{app.distribution.version}.dmg</strong>.
        </li>
        <li>Open the DMG.</li>
        <li>Drag Override to Applications.</li>
        <li>Eject the DMG.</li>
        <li>Launch Override from Applications.</li>
      </ol>
    </div>
    <div>
      <h3>Window access is your choice.</h3>
      <p>
        Override needs Accessibility permission to manage other applications’
        windows. Open Settings from Override’s menu bar item, then grant access
        yourself in System Settings → Privacy &amp; Security → Accessibility.
      </p>
      <p>
        After granting access, enable the window behaviours you want in
        Override.
      </p>
      {app.pages.accessibility && (
        <a class="text-link" href={href(`/apps/${app.slug}/accessibility/`)}>
          Accessibility &amp; permissions <span aria-hidden="true">↗</span>
        </a>
      )}
      <p>
        Updating? Quit Override before replacing the installed app.
        Installation, uninstall, and troubleshooting guidance are on the support
        page.
      </p>
      <a class="text-link" href={href(`/apps/${app.slug}/support/`)}>
        Override support <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="closing wrap">
    <div>
      <h2>
        Make space.
        <br />
        Keep your choices.
      </h2>
      <p>
        {app.compatibility} Beta {app.distribution.version}.
      </p>
    </div>
    <div class="closing-actions">
      <Availability app={app} />
    </div>
  </section>
</Site>
