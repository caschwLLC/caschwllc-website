---
import type { App } from '../lib/catalog';
import { storeAction } from '../lib/catalog';
interface Props {
  app: App;
}
const { app } = Astro.props;
const action = storeAction(app);
---

{action.href ? (
  <a
    class="button"
    href={action.href}
    rel="noopener noreferrer"
    data-analytics-event={
      app.presentation === 'utility' ? 'download_click' : 'store_click'
    }
    data-analytics-app={app.slug}
    data-analytics-version={
      app.presentation === 'utility' ? app.distribution.version : undefined
    }
  >
    {action.label}
    <span aria-hidden="true"> ↗</span>
  </a>
) : (
  <span class="status">{action.label}</span>
)}
