---
import '../styles/site.css';
import { getApps } from '../lib/content';
import { localPath, navigation } from '../lib/catalog';
import { siteConfig } from '../../site.config.mjs';
import Analytics from '../components/Analytics.astro';
const review = siteConfig().mode === 'review';
interface Props {
  title: string;
  description: string;
  appSlug?: string;
  noindex?: boolean;
  policy?: boolean;
  adaptiveColorScheme?: boolean;
}
const {
  title,
  description,
  appSlug,
  noindex = false,
  policy = false,
  adaptiveColorScheme = false,
} = Astro.props;
const apps = await getApps();
const groups = navigation(apps);
const base = import.meta.env.BASE_URL;
const href = (path: string) => localPath(path, base);
const canonical = new URL(
  noindex ? href('/404.html') : Astro.url.pathname,
  Astro.site,
);
const activeApp = apps.find((app) => app.slug === appSlug);
const supportApp = activeApp;
const reviewBanner =
  review && !policy
    ? activeApp?.slug === 'override'
      ? 'Public Preview -- Coming soon.'
      : activeApp?.slug === 'feelory'
        ? 'Coming soon.'
        : undefined
    : undefined;
const socialApp = appSlug ? activeApp : apps[0];
const socialIcon = socialApp?.icon;
const socialImage = socialApp?.socialImage;
const socialSrc = socialImage?.src ?? socialIcon;
const socialAlt = socialImage?.alt ?? `${socialApp?.name} app artwork`;
const discovery = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || review) && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    {adaptiveColorScheme ? (
      <>
        <meta
          name="theme-color"
          content="#f5f5f2"
          media="(prefers-color-scheme: light)"
        />
        <meta
          name="theme-color"
          content="#17181a"
          media="(prefers-color-scheme: dark)"
        />
        <meta name="color-scheme" content="light dark" />
      </>
    ) : (
      <meta name="theme-color" content="#f5f5f2" />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="caschw LLC" />
    {socialSrc && (
      <meta
        property="og:image"
        content={new URL(href(socialSrc), Astro.site)}
      />
    )}
    {socialSrc && <meta property="og:image:alt" content={socialAlt} />}
    {socialImage && (
      <>
        <meta property="og:image:width" content={String(socialImage.width)} />
        <meta property="og:image:height" content={String(socialImage.height)} />
        <meta
          name="twitter:image"
          content={new URL(href(socialImage.src), Astro.site)}
        />
        <meta name="twitter:image:alt" content={socialAlt} />
      </>
    )}
    <meta
      name="twitter:card"
      content={socialImage ? 'summary_large_image' : 'summary'}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(discovery).replace(/</g, '\\u003c')}
    />
    <Analytics excluded={noindex} />
  </head>
  <body
    class:list={[adaptiveColorScheme && 'theme-adaptive']}
    data-app={appSlug}
  >
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href={href('/')} aria-label="caschw LLC home">
        caschw <span>LLC</span>
      </a>
      <nav aria-label="Main navigation">
        {groups.map((group) => (
          <div class="nav-group">
            {group.label && <span class="nav-group-label">{group.label}</span>}
            {group.apps.map((app) => (
              <a
                href={href(`/apps/${app.slug}/`)}
                aria-current={
                  Astro.url.pathname === href(`/apps/${app.slug}/`)
                    ? 'page'
                    : undefined
                }
              >
                {app.name}
              </a>
            ))}
          </div>
        ))}
        {supportApp ? (
          <a
            href={href(`/apps/${supportApp.slug}/support/`)}
            aria-current={
              Astro.url.pathname === href(`/apps/${supportApp.slug}/support/`)
                ? 'page'
                : undefined
            }
          >
            Support
          </a>
        ) : (
          <a href="mailto:apps@caschw.com">Contact</a>
        )}
      </nav>
    </header>
    {reviewBanner && (
      <aside class="review-banner" aria-label="App preview status">
        {reviewBanner}
      </aside>
    )}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <a class="wordmark" href={href('/')}>
          caschw <span>LLC</span>
        </a>
        <p>Software for everyday moments.</p>
      </div>
      <nav aria-label="Footer navigation">
        <a href="mailto:apps@caschw.com">apps@caschw.com</a>
        <a href={href('/privacy/')}>Website privacy</a>
      </nav>
      <small>
        © {new Date().getUTCFullYear()} caschw LLC. All rights reserved.
      </small>
    </footer>
  </body>
</html>
