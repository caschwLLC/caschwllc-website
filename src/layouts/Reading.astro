---
import Site from './Site.astro';
import { localPath } from '../lib/catalog';
import publication from '../content/publication.json';
import { getApps } from '../lib/content';
interface Props {
  title: string;
  description: string;
  appSlug?: string;
  policy?: boolean;
}
const { title, description, appSlug, policy = false } = Astro.props;
const app = appSlug
  ? (await getApps()).find((app) => app.slug === appSlug)
  : undefined;
---

<Site
  title={`${title} · caschw LLC`}
  description={description}
  appSlug={appSlug}
  policy={policy}
>
  <article class="reading">
    <a
      class="back-link"
      href={localPath(
        appSlug ? `/apps/${appSlug}/` : '/',
        import.meta.env.BASE_URL,
      )}
    >
      <span aria-hidden="true">← </span>
      {appSlug ? 'Back to Feelory' : 'Back to home'}
    </a>
    <h1>{title}</h1>
    {policy && app?.status === 'coming-soon' && (
      <p class="policy-availability">
        {app.name} is coming soon. This policy describes how {app.name} handles
        your information.
      </p>
    )}
    {policy && publication.responsiblePublisher && (
      <p>Responsible publisher: {publication.responsiblePublisher}</p>
    )}
    {policy && publication.effectiveDate && (
      <p>
        Effective:{' '}
        <time datetime={publication.effectiveDate}>
          {publication.effectiveDate}
        </time>
      </p>
    )}
    <div class="prose">
      <slot />
    </div>
  </article>
</Site>
