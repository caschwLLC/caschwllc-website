---
import Site from './Site.astro';
import { localPath } from '../lib/catalog';
import publication from '../content/publication.json';
import { getApps } from '../lib/content';
import WebsitePrivacyNotice from '../components/WebsitePrivacyNotice.astro';
import WebsiteAnalyticsDisclosure from '../components/WebsiteAnalyticsDisclosure.astro';
interface Props {
  title: string;
  description: string;
  appSlug?: string;
  policy?: boolean;
  adaptiveColorScheme?: boolean;
  effectiveDate?: string;
  updatedOn?: string;
}
const {
  title,
  description,
  appSlug,
  policy = false,
  adaptiveColorScheme = false,
  effectiveDate,
  updatedOn,
} = Astro.props;
const app = appSlug
  ? (await getApps()).find((app) => app.slug === appSlug)
  : undefined;
---

<Site
  title={`${title} · caschw LLC`}
  description={description}
  appSlug={appSlug}
  policy={policy}
  adaptiveColorScheme={adaptiveColorScheme}
>
  <article class="reading">
    <a
      class="back-link"
      href={localPath(
        appSlug ? `/apps/${appSlug}/` : '/',
        import.meta.env.BASE_URL,
      )}
    >
      <span aria-hidden="true">← </span>
      {app ? `Back to ${app.name}` : 'Back to home'}
    </a>
    <h1>{title}</h1>
    {policy && app?.status === 'coming-soon' && (
      <p class="policy-availability">
        {app.name} is coming soon. This policy describes how {app.name} handles
        your information.
      </p>
    )}
    {policy && publication.responsiblePublisher && (
      <p>Responsible publisher: {publication.responsiblePublisher}</p>
    )}
    {policy && effectiveDate && (
      <p>
        Effective: <time datetime={effectiveDate}>{effectiveDate}</time>
      </p>
    )}
    {updatedOn && (
      <p>
        Last updated: <time datetime={updatedOn}>{updatedOn}</time>
      </p>
    )}
    <div class="prose">
      <slot />
      {policy &&
        (app ? <WebsitePrivacyNotice /> : <WebsiteAnalyticsDisclosure />)}
    </div>
  </article>
</Site>
